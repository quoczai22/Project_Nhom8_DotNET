<Window x:Class="QuanLyLinhKienMayTinh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Quản Lý Linh Kiện Máy Tính"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#f0f2f8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Sidebar Menu Button -->
        <Style x:Key="menuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c5cae9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#ffffff18"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#ffffff28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Menu Button -->
        <Style x:Key="menuButtonActive" TargetType="Button" BasedOn="{StaticResource menuButton}">
            <Setter Property="Background" Value="#ffffff22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Menu Icon Style -->
        <Style x:Key="menuButtonIcon" TargetType="PackIconMaterialBase">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Top Action Button -->
        <Style x:Key="topButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#4a5568"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f2ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Box -->
        <Style x:Key="textboxSearch" TargetType="TextBox">
            <Setter Property="Padding" Value="40,10,40,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2d3748"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dashboard Card -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.07" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4a5568"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1a202c"/>
        </Style>

        <!-- Sidebar Animation -->
        <Style x:Key="SidebarAnimationStyle" TargetType="Border">
            <Setter Property="Width" Value="64"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Open">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="220" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                 To="64" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border x:Name="SidebarBorder" Grid.Column="0"
                Background="#3f51b5" CornerRadius="0,16,16,0"
                ClipToBounds="True" Panel.ZIndex="10">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SidebarAnimationStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnHoverMenu}" Value="True">
                            <Setter Property="Tag" Value="Open"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Tag" Value="Open"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <!-- Top: Logo + User -->
                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,20">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#ffffff22"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="🖥️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentUsername}" Foreground="White"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="8,0"/>
                    <TextBlock Text="Quản trị viên" Foreground="#9fa8da"
                               FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Bottom: Logout -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource menuButton}"
                        Command="{Binding LogOutCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                        Margin="8,0,8,16">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="Logout" Style="{StaticResource menuButtonIcon}"
                                               Foreground="#ef9a9a"/>
                        <TextBlock Text="Đăng xuất" VerticalAlignment="Center" Foreground="#ef9a9a"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle DockPanel.Dock="Bottom" Height="1" Fill="#ffffff18" Margin="16,0,16,8"/>

                <!-- Menu Items -->
                <StackPanel Margin="0,4,0,0">
                    <Button Style="{StaticResource menuButton}" Click="btnDashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ViewDashboardOutline" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Trang Chủ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource menuButton}" Click="btnLinhKien_Click">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Memory" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Linh Kiện" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource menuButton}" Click="btnLoaiLK_Click">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="TagMultiple" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Loại Linh Kiện" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource menuButton}" Click="btnKhachHang_Click">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="AccountGroupOutline" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Khách Hàng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource menuButton}" Click="btnNhanVien_Click">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="AccountTie" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Nhân Viên" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource menuButton}" Click="btnHoaDon_Click">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ReceiptOutline" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Hóa Đơn" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1" Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hamburger -->
                <Button x:Name="btnHoverMenu" Grid.Column="0" Style="{StaticResource topButton}" Margin="0,0,12,0">
                    <Icon:PackIconMaterial Kind="Menu" Width="16" Height="16"/>
                </Button>

                <!-- Search -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="txtSearch" Style="{StaticResource textboxSearch}"
                             TextChanged="txtSearch_TextChanged"/>
                    <TextBlock Margin="16,0" VerticalAlignment="Center" Foreground="#b0b9c6"
                               IsHitTestVisible="False" Panel.ZIndex="1" Text="🔍  Tìm kiếm..."
                               Visibility="{Binding ElementName=txtSearch, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Spacer -->
                <Grid Grid.Column="2"/>

                <!-- Right Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource topButton}" Margin="0,0,8,0" Command="{Binding ThongBaoCommand}">
                        <Icon:PackIconMaterial Kind="BellOutline" Width="16" Height="16"/>
                    </Button>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#3f51b5">
                        <TextBlock Text="{Binding CurrentUsername[0]}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Content Frame -->
            <Border Grid.Row="1" Background="White" CornerRadius="16" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.07" Color="#000000"/>
                </Border.Effect>
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>
    </Grid>
</Window>
